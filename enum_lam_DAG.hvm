
data list{#Nil #Cons{a b}}
data net{#Node{c1 c2} #Leaf{v}}
data pair{#Pair{fst snd}}

@and(a b) =~a{
    0:0
    p:b
  }

@nand(a b) = (- 1 @and(a b))

@or(a b) = ~a !b{
  0: b
  p: 1
}

@sublayer(head secondary rest) = ~secondary !rest{
  #Nil: rest
  #Cons{h t}:
    ! &{h1 h2} = head
    #Cons{
      #Node{h h1}
      @sublayer(h2 t rest)}
}

@layer(srcs rest) =
  !&{s1 s2} = srcs
  ~s1 !rest{
  #Nil: rest
  #Cons{h tail}:
    @sublayer(h s2 @layer(tail rest))
}

@nets(srcs stack) =
  ~stack !srcs{
    #Nil:
      ! &{l1 l2} = @layer(srcs #Nil)
      @nets(l1 l2)
    #Cons{h t}:
      &77{
        h
        @nets(srcs t)
      }
  }

@map(fn ls) = ~ls{ #Nil:[] #Cons{h t}: ! &{f1 f2} = fn #Cons{(f1 h) @map(f2 t)}}

@when(c t) = ~ c {0: * p: t}

@concat(a b) = ~a !b{#Nil: b #Cons{h t}: #Cons{h @concat(t b)}}

@lmap(f l)=~l{
  #Nil: #Nil
  #Cons{h t}:
    ! &{f1 f2} = f
    #Cons{(f1 h) @lmap(f2 t)}
}

@gensup(&N) = ~(- &N 0){
  0: λx x
  &p: λf (@gensup(&p) (f &p{0 1}))
}


@collapse(&N x) =
  ~(+ &N 0) !x{
  0: λf (x)
  &p:
    ! &p{x1 x2} = @collapse(&p x)
    λf !&{f f1} = f !&{f f2} = f
    ((f (x1 f1)) (x2 f2))
  }


@main = @gensup(3)


