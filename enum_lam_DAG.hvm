
data list{#Nil #Cons{a b}}

@nand(a b) = (- 1 (* a b))

@nand(a b) =(- 1 ~a{
    0:0
    p:b
  })

@sublayer(head secondary rest) = ~secondary !rest{
  #Nil: rest
  #Cons{h t}:
    ! &{h1 h2} = head
    #Cons{
      @nand(h h1)
      @sublayer(h2 t rest)}
}

@layer(srcs rest) =
  !&{s1 s2} = srcs
  ~s1 !rest{
  #Nil: rest
  #Cons{h tail}:
    @sublayer(h s2 @layer(tail rest))
}

@nets(srcs stack) =
  ~stack !srcs{
    #Nil:
      ! &{l1 l2} = @layer(srcs #Nil)
      @nets(l1 l2)
    #Cons{h t}:
      &77{
        h
        @nets(srcs t)
      }
  }


@map(fn ls) = ~ls{ #Nil:[] #Cons{h t}: ! &{f1 f2} = fn #Cons{(f1 h) @map(f2 t)}}

@when(c t) = ~ c {0: * p: t}

@concat(a b) = ~a !b{#Nil: b #Cons{h t}: #Cons{h @concat(t b)}}

@X(n) = ~n{
  0: #Cons{#Nil #Nil}
  p:
    !&0{a b} = @map(λx #Cons{&0{0 1} x} @X(p))
    @concat(a b)
}

@solved(fn) = @when((@X fn) @X)

@app(f arglist) = ~arglist !f{#Nil: f #Cons{h t}: @app((f h) t)}

@all(l) = ~l{#Nil: 1 #Cons{h t}: ~h{0:0 p:@all(t)}}

// @t = λa λb λc (* a b)
@t = λa λb λc @nand(a b)

@check(f) = λargs
  ! &{a1 a2} = args
  (== @app(f a1) @app(@t a2))

@main =

  !&{n1 n2} = λa λb λc @nets([a b c] #Nil)
  @when(@all(@map(@check(n1) @X(3))) n2)

// @main = λa λb λc @nets([a b c] #Nil)

@main =
  !nn = (λa λb @nets([a b] #Nil))
  !&77{a b} = nn
  !&77{a b} = a
  // (λx λy λz (((a x) y) z))

  λa λb @nand(a b)

@main =
  ((λa @nand(a 0)) 0)