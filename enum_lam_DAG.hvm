data list{#Nil #Cons{a b}}

@nand(a b) = (- 1 (* a b))

@nand(a b) =(- 1 ~a{
    0:0
    p:b
  })

@sublayer(head secondary rest) = ~secondary !rest{
  #Nil: rest
  #Cons{h t}:
    ! &{h1 h2} = head
    #Cons{[h1 h] @sublayer(h2 t rest)}
}

@layer(srcs rest) =
  !&{s1 s2} = srcs
  ~s1 !rest{
  #Nil: rest
  #Cons{h tail}:
    @sublayer(h s2 @layer(tail rest))
}

@nets(srcs stack) =
  ~stack !srcs{
    #Nil:
      ! &{l1 l2} = @layer(srcs #Nil)
      @nets(l1 l2)
    #Cons{h t}:
      &0{
        h
        @nets(srcs t)
      }
  }

@main = @nets([1 2 3] #Nil)

